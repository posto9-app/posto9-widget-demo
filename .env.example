# Copy this file to .env and fill it in. Never commit .env.

# Your Posto9 address, the one in the snippet under Setup > Tenant > Chat widget.
POSTO9_URL=https://your-posto9-address

# From Setup > Tenant > Chat widget in Posto9.
POSTO9_WIDGET_ID=00000000-0000-0000-0000-000000000000
POSTO9_WIDGET_SECRET=paste-the-secret-here

# The people who can sign in to this demo portal: "Name <email>", comma separated.
# Each email must be a member of your Posto9 workspace who can chat. Add one that
# is not, to show how the widget refuses a non-member.
DEMO_USERS=Sarah Chen <sarah@yourcompany.com>, Michael Ross <michael@yourcompany.com>

# Port this demo listens on.
PORT=3000
